{
  "compilerOptions": {
    "baseUrl": "..",
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "next/image": ["./.design-sync/shims/next-image.tsx"]
    }
  }
}
