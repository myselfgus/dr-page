{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "page-drgustavomendes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  
  // Static assets configuration
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // D1 database for blog posts
  "d1_databases": [
    {
      "binding": "dr_blog",
      "database_name": "dr-blog",
      "database_id": "3435a1ad-b8f4-4652-bc7c-729071bd2cd4"
    }
  ],
  
  // Disable metrics for better performance
  "send_metrics": false,
  
  // Observability
  "observability": {
    "enabled": true
  }
}
